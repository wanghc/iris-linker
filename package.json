{
  "name": "iris-linker",
  "displayName": "iris-linker",
  "publisher": "wanghc",
  "description": "support Ctrl+click jump for Js/Css in CSP files, export file to XML",
  "version": "0.0.6",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:objectscript-csp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wanghc/iris-linker.git"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "iris-linker.version",
        "title": "IRIS CSP Linker"
      },
      {
        "command": "iris-linker.exportToXML",
        "title": "Export File to XML"
      },
      {
        "command": "iris-linker.syncAllToServer",
        "title": "Sync All to IRIS Server",
        "icon": "$(cloud-upload)",
        "category": "IRIS Linker"
      }
    ],
    "configuration": {
      "title": "IRIS Linker",
      "properties": {
        "iris-linker.localExport.defaultServer": {
          "type": "string",
          "default": "",
          "description": "Default InterSystems server name for local file export (e.g. 'mylocal')"
        },
        "iris-linker.localExport.stripPrefix": {
          "type": "string",
          "default": "",
          "description": "Strip this prefix from workspace-relative path when building the server document name. e.g. set 'src/' if your classes live under src/ in the workspace but not on the server"
        },
        "iris-linker.sync.ignoreConflict": {
          "type": "boolean",
          "default": true,
          "description": "Ignore server conflicts when syncing (PUT ?ignoreConflict=1)"
        },
        "iris-linker.sync.includeUntracked": {
          "type": "boolean",
          "default": false,
          "description": "Include untracked files in sync"
        },
        "iris-linker.sync.confirmBeforeSync": {
          "type": "boolean",
          "default": true,
          "description": "Show confirmation dialog before syncing"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "when": "(resourceScheme == isfs || resourceScheme == file) && resourceExtname =~ /\\.(cls|mac|int|csp|js|css|html?|png|jpe?g|gif|bmp|ico|webp|eot|otf|ttf|woff2?|pdf)$/i",
          "command": "iris-linker.exportToXML",
          "group": "1_modification"
        }
      ],
      "explorer/context": [
        {
          "when": "(resourceScheme == isfs || resourceScheme == file) && resourceExtname =~ /\\.(cls|mac|int|csp|js|css|html?|png|jpe?g|gif|bmp|ico|webp|eot|otf|ttf|woff2?|pdf)$/i",
          "command": "iris-linker.exportToXML",
          "group": "7_modification"
        }
      ],
      "editor/title/context": [
        {
          "when": "(resourceScheme == isfs || resourceScheme == file) && resourceExtname =~ /\\.(cls|mac|int|csp|js|css|html?|png|jpe?g|gif|bmp|ico|webp|eot|otf|ttf|woff2?|pdf)$/i",
          "command": "iris-linker.exportToXML",
          "group": "1_modification"
        }
      ],
      "scm/title": [
        {
          "command": "iris-linker.syncAllToServer",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    }
  },
  "enabledApiProposals": ["contribEditorContentMenu"],
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "dev": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "axios": "^1.13.6"
  }
}
